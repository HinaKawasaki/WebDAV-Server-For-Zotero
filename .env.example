# Copy this file to `.env` (which is ignored by git) and adjust the values.
# Environment variables that are already set always win over this file.

# --- HTTP server ---------------------------------------------------------- #
# Keep this on loopback: the SSH tunnel is the only intended entry point.
WEBDAV_HOST=127.0.0.1
WEBDAV_PORT=8000
WEBDAV_LOG_LEVEL=INFO
#WEBDAV_LOG_FILE=/var/log/zotero-webdav/server.log
#WEBDAV_REALM=Zotero WebDAV Storage
#WEBDAV_NUM_THREADS=20
#WEBDAV_REQUEST_QUEUE_SIZE=128
#WEBDAV_LOGIN_MAX_ATTEMPTS=10
#WEBDAV_LOGIN_WINDOW_SECONDS=300
#WEBDAV_LOGIN_BASE_PENALTY=2
#WEBDAV_LOGIN_MAX_PENALTY=300
# Upper bound on the number of (user, source address) pairs the throttle keeps.
#WEBDAV_LOGIN_MAX_KEYS=4096
#WEBDAV_AUTH_CACHE_SECONDS=45
#WEBDAV_AUTH_CACHE_MAX_ENTRIES=512
# Dead properties and locks are stored in MariaDB so they survive a restart.
#WEBDAV_PERSIST_PROPERTIES=true
#WEBDAV_PERSIST_LOCKS=true
#WEBDAV_PROPERTIES_TABLE=dav_properties
#WEBDAV_LOCKS_TABLE=dav_locks

# --- Storage -------------------------------------------------------------- #
# Base directory.  Relative paths are resolved against the project root.
WEBDAV_SHARE_DIR=./zotero
# Every account gets its own directory below WEBDAV_SHARE_DIR and is served at
# /<username>/.  Disabling this restores the old shared-root behaviour (all
# accounts see the same files, and locks/dead properties are shared).
#WEBDAV_PER_USER_STORAGE=true

# --- Database (MariaDB / MySQL) ------------------------------------------- #
WEBDAV_DB_HOST=127.0.0.1
WEBDAV_DB_PORT=3306
WEBDAV_DB_USER=webdav
WEBDAV_DB_PASSWORD=change-me
WEBDAV_DB_NAME=webdav
WEBDAV_DB_TABLE=dav_users

# --- Local development against the remote MariaDB ------------------------- #
# MariaDB on the server listens on 127.0.0.1 only, so forward it over SSH:
#
#   tools/dev_db_tunnel.sh ubuntu@<server>
#
# and point the client at the forwarded port:
#
#WEBDAV_DB_HOST=127.0.0.1
#WEBDAV_DB_PORT=13306
